<!-- 简体中文汉化修改：本文件的用户界面文案已译为简体中文，其余布局与官方版本一致。 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenNetMeter.ViewModels"
             xmlns:ctrl="using:OpenNetMeter.Views.Controls"
             x:Class="OpenNetMeter.Views.MainWindowTabs.HistoryView"
             x:DataType="vm:HistoryViewModel"
             mc:Ignorable="d">
  <UserControl.Styles>
    <Style Selector="Button.rowBtn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.rowBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushBgSurfaceHover}"/>
    </Style>
    <Style Selector="DockPanel.exportStatus">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.35"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="DockPanel.exportStatus.shown">
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </UserControl.Styles>

  <Grid Margin="12,8" RowDefinitions="Auto,*,Auto">
    <Border Padding="12" CornerRadius="8" Background="{DynamicResource BrushSurfacePanel}">
      <StackPanel Spacing="8" HorizontalAlignment="Center">
      <StackPanel x:Name="FilterControls" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock VerticalAlignment="Center" Text="{DynamicResource His.Profile}"/>
        <ComboBox Width="180"
                  ItemsSource="{Binding Profiles}"
                  SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"/>
        <TextBlock VerticalAlignment="Center" Text="{DynamicResource His.From}"/>
        <DatePicker MinWidth="0" Height="30" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    SelectedDate="{Binding DateStart, Mode=TwoWay}"/>
        <TextBlock VerticalAlignment="Center" Text="{DynamicResource His.To}"/>
        <DatePicker MinWidth="0" Height="30" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    SelectedDate="{Binding DateEnd, Mode=TwoWay}"/>
        <Button Width="64" Height="24" Padding="0" Command="{Binding FilterCommand}">
          <TextBlock Text="{DynamicResource His.Filter}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Button>
        <Button Width="64" Height="24" Padding="0" Command="{Binding ExportCommand}"
                ToolTip.Tip="{DynamicResource His.ExportTip}">
          <TextBlock Text="{DynamicResource Common.Export}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Button>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <TextBlock VerticalAlignment="Center" FontSize="10"
                   Foreground="{DynamicResource BrushTextMuted}"
                   Text="{DynamicResource His.ProcessFilter}"/>
        <TextBox Width="176" Height="24" FontSize="11" Padding="6,0" CornerRadius="4"
                 VerticalContentAlignment="Center"
                 Watermark="{DynamicResource His.ProcessFilterHint}"
                 Text="{Binding ProcessFilter, Mode=TwoWay}"/>
        <Button Width="88" Height="24" Padding="0" Command="{Binding ExportDetailCommand}"
                ToolTip.Tip="{DynamicResource His.ExportDetailTip}">
          <TextBlock Text="{DynamicResource His.ExportDetail}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Button>
      </StackPanel>

      <!-- Persistent status line, as wide as the controls row: when results were last loaded (left) and the
           export feedback (right), which fades in and out so the filter bar never changes height. -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" MinHeight="16"
            Width="{Binding #FilterControls.Bounds.Width}">
        <!-- "Last filtered <profile> · <time>": the profile is the one the results were loaded for, which can differ
             from the dropdown until the next filter. Its MaxWidth keeps the export area's space. -->
        <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center"
                    IsVisible="{Binding HasLastFiltered}">
          <TextBlock Text="{DynamicResource His.LastFiltered}" VerticalAlignment="Center"
                     Foreground="{DynamicResource BrushTextMuted}"/>
          <TextBlock Text="{Binding LastFilteredProfile}" Margin="4,0,0,0" MaxWidth="180" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource BrushTextBody}"
                     ToolTip.Tip="{Binding LastFilteredProfile}"/>
          <TextBlock Text="{Binding LastFilteredTimeText, StringFormat='· {0}'}" Margin="4,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource BrushTextMuted}"/>
        </StackPanel>
        <DockPanel Grid.Column="1" Classes="exportStatus" Classes.shown="{Binding ExportStatus.IsVisible}"
                   IsHitTestVisible="{Binding ExportStatus.IsVisible}"
                   HorizontalAlignment="Right" LastChildFill="True">
          <PathIcon DockPanel.Dock="Left" Width="12" Height="12" VerticalAlignment="Center"
                    Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                    Foreground="{DynamicResource BrushDownload}"
                    IsVisible="{Binding ExportStatus.IsSuccess}"/>
          <PathIcon DockPanel.Dock="Left" Width="12" Height="12" VerticalAlignment="Center"
                    Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                    Foreground="{DynamicResource BrushDangerBright}"
                    IsVisible="{Binding ExportStatus.IsError}"/>
          <TextBlock DockPanel.Dock="Left" Margin="6,0,0,0" VerticalAlignment="Center"
                     Text="{Binding ExportStatus.Message}"
                     Foreground="{DynamicResource BrushTextMuted}"/>
          <!-- Bound to IsSuccess rather than CanReveal: CanReveal drops on hide and would collapse the link mid-fade. -->
          <Button DockPanel.Dock="Right" Classes="linkBtn" VerticalAlignment="Center" Margin="6,0,0,0"
                  Command="{Binding ExportStatus.RevealCommand}"
                  IsVisible="{Binding ExportStatus.IsSuccess}">
            <TextBlock Text="{DynamicResource Common.OpenFolder}" Foreground="{DynamicResource BrushLink}" TextDecorations="Underline"/>
          </Button>
          <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                     TextTrimming="PrefixCharacterEllipsis"
                     Text="{Binding ExportStatus.FileName}"
                     Foreground="{DynamicResource BrushTextMuted}"
                     ToolTip.Tip="{Binding ExportStatus.FilePath}"
                     IsVisible="{Binding ExportStatus.IsSuccess}"/>
        </DockPanel>
      </Grid>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="0,12,0,12" ColumnDefinitions="*,Auto">
      <Border Grid.Column="0" Padding="0" CornerRadius="8" Background="{DynamicResource BrushSurfacePanel}" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource BrushHeaderRow}" BorderBrush="{DynamicResource BrushBorderEmphasis}" BorderThickness="0,0,0,0.4">
          <Grid ColumnDefinitions="3*,1.5*,1.5*">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{DynamicResource Col.Process}" Foreground="{DynamicResource BrushTextHeader}"
                         FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <Button Command="{Binding SortRowsCommand}" CommandParameter="Process"
                      Background="{DynamicResource BrushHeaderRow}" BorderBrush="{DynamicResource BrushBorderEmphasis}"
                      BorderThickness="1" CornerRadius="4" Padding="4,2">
                <ctrl:SortIndicatorControl ColumnName="Process"
                                           CurrentSortColumn="{Binding CurrentSortColumn}"
                                           IsSortDescending="{Binding IsSortDescending}"/>
              </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <TextBlock Text="{DynamicResource His.ColReceived}" Foreground="{DynamicResource BrushTextHeader}"
                         FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <Button Command="{Binding SortRowsCommand}" CommandParameter="Download"
                      Background="{DynamicResource BrushHeaderRow}" BorderBrush="{DynamicResource BrushBorderEmphasis}"
                      BorderThickness="1" CornerRadius="4" Padding="4,2">
                <ctrl:SortIndicatorControl ColumnName="Download"
                                           CurrentSortColumn="{Binding CurrentSortColumn}"
                                           IsSortDescending="{Binding IsSortDescending}"/>
              </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <TextBlock Text="{DynamicResource His.ColSent}" Foreground="{DynamicResource BrushTextHeader}"
                         FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <Button Command="{Binding SortRowsCommand}" CommandParameter="Upload"
                      Background="{DynamicResource BrushHeaderRow}" BorderBrush="{DynamicResource BrushBorderEmphasis}"
                      BorderThickness="1" CornerRadius="4" Padding="4,2">
                <ctrl:SortIndicatorControl ColumnName="Upload"
                                           CurrentSortColumn="{Binding CurrentSortColumn}"
                                           IsSortDescending="{Binding IsSortDescending}"/>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,0,0,6">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="rowBtn" Command="{Binding ShowDetailCommand}">
                <Grid ColumnDefinitions="3*,1.5*,1.5*" Margin="10,4">
                  <Grid ColumnDefinitions="Auto,Auto,*" MinWidth="0">
                    <Button Command="{Binding SearchProcessCommand}"
                            Background="Transparent" BorderThickness="0"
                            Padding="2" Cursor="Hand"
                            ToolTip.Tip="{DynamicResource Tip.SearchOnline}">
                      <PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Width="12" Height="12"
                              Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Button>
                    <Image Grid.Column="1" Source="{Binding Icon}" Width="16" Height="16" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding ProcessName}" Foreground="{DynamicResource BrushTextBody}" FontSize="11"
                               TextWrapping="Wrap" MinWidth="0" VerticalAlignment="Center" Margin="4,0,0,0"/>
                  </Grid>
                  <TextBlock Grid.Column="1" Text="{Binding DownloadText}" Foreground="{DynamicResource BrushTextBody}" FontSize="11" VerticalAlignment="Top"/>
                  <TextBlock Grid.Column="2" Text="{Binding UploadText}" Foreground="{DynamicResource BrushTextBody}" FontSize="11" VerticalAlignment="Top"/>
                </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
      </Border>

      <!-- 明细面板：展示所选进程的按日用量 -->
      <Border Grid.Column="1" Width="248" Margin="12,0,0,0" CornerRadius="8"
              Background="{DynamicResource BrushSurfacePanel}" ClipToBounds="True"
              IsVisible="{Binding IsDetailOpen}">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0" Padding="10,7" Background="{DynamicResource BrushHeaderRow}"
                  BorderBrush="{DynamicResource BrushBorderEmphasis}" BorderThickness="0,0,0,0.4">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{DynamicResource His.DetailTitle}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextHeader}" VerticalAlignment="Center"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="linkBtn" VerticalAlignment="Center"
                      Command="{Binding CloseDetailCommand}">
                <TextBlock Text="{DynamicResource Common.Close}" FontSize="10"
                           Foreground="{DynamicResource BrushLink}" TextDecorations="Underline"/>
              </Button>
            </Grid>
          </Border>

          <StackPanel Grid.Row="1" Margin="10,8,10,0">
            <TextBlock Text="{Binding Detail.ProcessName}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{DynamicResource His.DetailByDay}" FontSize="9" Margin="0,2,0,6"
                       Foreground="{DynamicResource BrushTextMuted}"/>
            <Grid ColumnDefinitions="*,1.1*,1.1*,1.1*" Margin="0,0,0,3">
              <TextBlock Text="{DynamicResource His.DetailDate}" FontSize="9" Foreground="{DynamicResource BrushTextHeader}"/>
              <TextBlock Grid.Column="1" Text="{DynamicResource Col.Download}" FontSize="9" Foreground="{DynamicResource BrushTextHeader}"/>
              <TextBlock Grid.Column="2" Text="{DynamicResource Col.Upload}" FontSize="9" Foreground="{DynamicResource BrushTextHeader}"/>
              <TextBlock Grid.Column="3" Text="{DynamicResource Common.Total}" FontSize="9" Foreground="{DynamicResource BrushTextHeader}"/>
            </Grid>
            <ScrollViewer MaxHeight="240">
              <ItemsControl ItemsSource="{Binding Detail.Days}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,1.1*,1.1*,1.1*" Margin="0,2">
                      <TextBlock Text="{Binding DateText}" FontSize="10" Foreground="{DynamicResource BrushTextBody}"/>
                      <TextBlock Grid.Column="1" Text="{Binding DownloadText}" FontSize="10" Foreground="{DynamicResource BrushDownload}"/>
                      <TextBlock Grid.Column="2" Text="{Binding UploadText}" FontSize="10" Foreground="{DynamicResource BrushUpload}"/>
                      <TextBlock Grid.Column="3" Text="{Binding TotalText}" FontSize="10" Foreground="{DynamicResource BrushTextBody}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{DynamicResource His.DetailHint}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource BrushTextMuted}"
                       IsVisible="{Binding !Detail.HasRows}"/>
          </StackPanel>

          <Border Grid.Row="2" Padding="10,6" Background="{DynamicResource BrushHeaderRow}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Text="{DynamicResource Common.Total}" FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource BrushTextHeader}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Detail.TotalDownloadText}" FontSize="10" HorizontalAlignment="Right"
                         Foreground="{DynamicResource BrushDownload}" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="2" Text="{Binding Detail.TotalUploadText}" FontSize="10"
                         Foreground="{DynamicResource BrushUpload}"/>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Padding="12" CornerRadius="8" Background="{DynamicResource BrushSurfacePanel}">
      <Grid ColumnDefinitions="2*,*,*">
        <TextBlock FontWeight="SemiBold" Text="{DynamicResource Common.Total}"/>
        <TextBlock Grid.Column="1" Text="{Binding TotalDownloadText}"/>
        <TextBlock Grid.Column="2" Text="{Binding TotalUploadText}"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
